# Dependencies (installed with `npm install`, never committed)
node_modules/

# Astro build output (generated by `npm run build`, never committed)
dist/
.astro/

# Environment / secrets (never commit these)
.env
.env.*

# Local tooling binaries (downloaded, not source code)
cloudflared.exe

# Claude Code local state / settings (machine-specific, not part of the site)
.claude.json
.claude/settings.local.json

# Node REPL history (junk)
.node_repl_history

# OS / editor junk
.DS_Store
Thumbs.db
