---
// index.astro: the HOME PAGE ("/")
// -----------------------------------------------------------------------------
// The home page wraps its content in <BaseLayout> (so it gets the announcement
// bar, header and footer for free) and adds:
//   1. a bold hero,
//   2. a responsive grid of "what we do" area cards,
//   3. an upcoming-events section,
//   4. the first-visit event pop-up with a live countdown.
//
// Everything is MOBILE-FIRST: sections stack in one column on phones and spread
// into multiple columns from the `sm`/`lg` breakpoints up.
// -----------------------------------------------------------------------------

import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import EventModal from '../components/EventModal.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import HeroVinyl from '../components/HeroVinyl.astro';
import { site } from '../data/site.js';
import eventsData from '../data/events.json';

// ---- 3D HERO ACCENT TOGGLE -------------------------------------------------
// Flip this to `false` to turn OFF the rotating 3D vinyl in the hero (handy for
// comparing the hero with and without it). When `true` it still only runs on
// capable desktops — phones, reduced-motion and no-WebGL get a static fallback.
const SHOW_HERO_3D = true;

// The five main areas of the business, shown as cards. Kept as a simple array
// so it's easy to edit/reorder later (data-driven, no layout changes needed).
// `image` is the photo shown in the card's photo area; `imageAlt` describes it
// for screen readers + SEO. Two cards use special image handling:
//   • Piano Valley uses `imageFit: 'contain'` so its LOGO (transparent PNG)
//     sits centred on the dark panel with padding, instead of being stretched.
//   • Artists uses `imagePosition: 'top'` so the DJ's face is never cropped out.
const areas = [
  {
    title: 'Equipment Hire',
    description: 'Sound, stage, lighting, projectors, decks and more for any event.',
    href: '/hire',
    image: '/images/equipment/sound-system.jpg',
    imageAlt: 'K1P sound system equipment available for hire',
  },
  {
    title: 'Services',
    description: 'Artist management, promotion, distribution, videography and design.',
    href: '/services',
    image: '/images/equipment/stage-platforms.jpg',
    imageAlt: 'Stage and event setup by K1P',
  },
  {
    title: 'Artists & DJs',
    description: 'Meet the talent signed to and managed by K1P Entertainment.',
    href: '/artists',
    image: '/images/artists/prise-tag.jpg',
    // Anchor the crop to the TOP so the face stays visible on every screen.
    imagePosition: 'top',
    imageAlt: 'K1P DJ Prise Tag performing',
  },
  {
    title: 'Piano Valley',
    description: 'Our YouTube channel dropping fresh house & amapiano mixes bi-weekly.',
    href: '/piano-valley',
    // The Piano Valley LOGO (transparent PNG). `imageFit: 'contain'` centres it
    // on the dark panel with padding so it reads as a logo, not a stretched image.
    image: '/images/logo/piano-valley-logo.png',
    imageFit: 'contain',
    imageAlt: 'Piano Valley logo',
  },
  {
    title: 'Recording Studio',
    description: 'Recording, mixing, mastering and custom beats. Book your session.',
    href: '/contact?enquiry=Studio+Booking',
    image: '/images/equipment/studio-time.jpg',
    imageAlt: 'K1P recording studio session',
  },
];

// All upcoming events (for the on-page list). The modal handles the headline one.
const upcomingEvents = eventsData.events;

// SEO: build an "Event" structured-data block for the headline event (the
// talent show). Google can show this as a rich event result. We only add it if
// there is a headline event.
const headlineEvent = upcomingEvents.find((event) => event.isHeadline);
const eventStructuredData = headlineEvent
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: headlineEvent.title,
        startDate: headlineEvent.date,
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        description: headlineEvent.description,
        location: {
          '@type': 'Place',
          name: headlineEvent.venue,
          address: {
            '@type': 'PostalAddress',
            // Full street address from the event data (so Google can map it).
            streetAddress: headlineEvent.address,
            addressLocality: 'Thohoyandou',
            addressRegion: 'Limpopo',
            postalCode: headlineEvent.postalCode,
            addressCountry: 'ZA',
          },
        },
        organizer: {
          '@type': 'Organization',
          name: site.name,
          url: 'https://k1pentertainment.co.za',
        },
      },
    ]
  : [];

// SEO: "Service" structured-data for K1P's two flagship offerings — the recording
// studio and event equipment hire — so they can surface as services in search.
// Both point back to the sitewide business via `provider`.
const provider = { '@type': 'LocalBusiness', name: site.name, telephone: site.phoneLink };
const serviceStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Recording studio',
    name: 'Recording, Mixing & Mastering Studio',
    description: `Recording studio in ${site.city}, ${site.region} for recording, mixing, mastering and custom beats — amapiano and house production.`,
    areaServed: `${site.city}, ${site.region}, South Africa`,
    provider,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Event equipment hire',
    name: 'Sound System, Stage, Lighting & DJ Equipment Hire',
    description: `Hire sound systems, stage & lighting, XDJ decks, microphones and projectors for events in ${site.city}, ${site.region}.`,
    areaServed: `${site.city}, ${site.region}, South Africa`,
    provider,
  },
];
---

<BaseLayout
  title="K1P Entertainment | Recording Studio, Sound & Stage Hire in Thohoyandou, Limpopo"
  description="K1P Entertainment in Thohoyandou (Venda), Limpopo — recording studio (record, mix & master), sound system & stage hire, DJ lessons, event equipment and the Piano Valley amapiano channel. Call or WhatsApp 063 687 9489."
  structuredData={[...serviceStructuredData, ...eventStructuredData]}
>
  {/* ===================================================================== */}
  {/* 1. HERO, big, bold, concert-poster energy.                            */}
  {/* ===================================================================== */}
  <section class="relative overflow-hidden">
    {/* A soft red glow blooming from behind the heading for stage-lighting feel. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-brand-red/20 blur-3xl"
    >
    </div>

    {/* Decorative 3D vinyl accent — sits BEHIND the text (it's z-0 + aria-hidden +
        pointer-events-none), so the headline and buttons stay on top and clickable.
        Toggle with SHOW_HERO_3D above. */}
    {SHOW_HERO_3D && <HeroVinyl />}

    {/* `z-10` keeps the headline + CTAs ABOVE the 3D accent and fully readable. */}
    <div class="container-page relative z-10 py-20 text-center sm:py-24 md:py-32">
      {/* ---- LOGO ---- The K1P wordmark, sized big for the hero. The "1" glows
          red to match the real logo. */}
      <p class="font-display text-3xl tracking-wide text-white sm:text-4xl">
        K<span class="text-brand-red text-glow">1</span>P
        <span class="text-grey">ENTERTAINMENT</span>
      </p>

      {/* Eyebrow label. tracking widens on bigger screens. */}
      <p class="mb-4 mt-6 text-xs font-semibold uppercase tracking-[0.25em] text-brand-red sm:text-sm sm:tracking-[0.3em]">
        Venda • Entertainment
      </p>

      {/* TAGLINE as the headline. Scales: phone text-4xl → desktop text-8xl.
          The last line glows red to echo the logo. */}
      <h1 class="text-4xl leading-none sm:text-6xl md:text-8xl">
        Turning Your<br />
        Musical Vision<br />
        <span class="text-brand-red text-glow">To Reality</span>
      </h1>

      {/* Supporting line — naturally works in the key services + our location
          (Thohoyandou, Limpopo) for local search, without keyword-stuffing. */}
      <p class="mx-auto mt-6 max-w-xl text-base text-grey sm:text-lg">
        Recording studio, sound and stage hire, a record label and musician
        management in Thohoyandou, Venda, Limpopo. One company for all of it.
      </p>

      {/* CTAs. WhatsApp is our PRIMARY booking method, so the green "Book on
          WhatsApp" button leads; the others (solid red, then outlined) follow.
          Full-width stacked on phones, side-by-side and wrapping from sm up.
          Each is well over 44px tall for easy tapping. */}
      <div class="mx-auto mt-10 flex max-w-md flex-col items-stretch justify-center gap-3 sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <WhatsAppButton message="Hi K1P Entertainment 👋 I'd like to make a booking / enquiry." />
        <a
          href="/hire"
          class="rounded bg-brand-red px-7 py-4 text-center font-semibold uppercase tracking-wide text-white shadow-glow transition hover:bg-brand-red-dark"
        >
          Hire Equipment
        </a>
        {/* "Book Studio" pre-fills the contact form's enquiry field via ?enquiry. */}
        <a
          href="/contact?enquiry=Studio+Booking"
          class="rounded border border-white/30 px-7 py-4 text-center font-semibold uppercase tracking-wide text-white transition hover:border-white hover:bg-white/5"
        >
          Book Studio
        </a>
      </div>
    </div>
  </section>

  {/* ===================================================================== */}
  {/* 2. WHAT WE DO, responsive card grid.                                  */}
  {/*    1 column on phones → 2 on small tablets → 3 on desktop.             */}
  {/*    `reveal` = fades/raises into view on scroll (see global.css).       */}
  {/* ===================================================================== */}
  <section class="reveal container-page py-12 sm:py-16">
    <div class="mb-8 text-center sm:mb-10">
      <h2 class="text-3xl sm:text-4xl md:text-5xl">What We Do</h2>
      <p class="mx-auto mt-3 max-w-xl text-grey">
        One team for the studio and the stage.
      </p>
    </div>

    {/* The responsive grid. `grid-cols-1` (phones) → `sm:grid-cols-2` →
        `lg:grid-cols-3`. `gap` grows a little on bigger screens. */}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {
        areas.map((area) => (
          // Each area card shows its photo (cover-filling the photo area) and is
          // a whole-card link to that section. Piano Valley passes an
          // `imageFallback` so its YouTube thumbnail degrades gracefully.
          <Card
            title={area.title}
            text={area.description}
            href={area.href}
            image={area.image}
            imageAlt={area.imageAlt}
            imageFit={area.imageFit}
            imagePosition={area.imagePosition}
            imageFallback={area.imageFallback}
          />
        ))
      }
    </div>
  </section>

  {/* ===================================================================== */}
  {/* 3. UPCOMING EVENTS, also a responsive grid.                           */}
  {/* ===================================================================== */}
  <section class="reveal container-page py-12 sm:py-16">
    <div class="mb-8 text-center sm:mb-10">
      <h2 class="text-3xl sm:text-4xl md:text-5xl">Upcoming Events</h2>
      <p class="mx-auto mt-3 max-w-xl text-grey">
        Don’t miss what’s next on the K1P calendar.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {
        upcomingEvents.map((event) => {
          // Friendly date for each event card (e.g. "5 July 2026").
          const when = new Date(event.date).toLocaleDateString('en-ZA', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          });
          return (
            <article class="flex h-full flex-col rounded-xl border border-white/10 bg-surface p-6">
              {/* "Headline" badge for the main event. */}
              {event.isHeadline && (
                <span class="mb-3 inline-block w-fit rounded-full bg-brand-red px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                  Headline
                </span>
              )}
              <h3 class="text-2xl text-white">{event.title}</h3>
              <p class="mt-1 text-sm text-brand-red">{when} • {event.venue}</p>
              <p class="mt-3 flex-1 text-sm text-grey">{event.description}</p>
              <a
                href={event.ctaLink}
                class="mt-5 inline-block w-full rounded bg-brand-red px-5 py-3 text-center font-semibold uppercase tracking-wide text-white transition hover:bg-brand-red-dark sm:w-auto"
              >
                {event.ctaLabel}
              </a>
            </article>
          );
        })
      }
    </div>
  </section>

  {/* ===================================================================== */}
  {/* 4. The first-visit pop-up with the live countdown.                     */}
  {/*    (Renders nothing visible until ~1.5s after load.)                   */}
  {/* ===================================================================== */}
  <EventModal />
</BaseLayout>
