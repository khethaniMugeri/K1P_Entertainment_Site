---
// merch.astro: the MERCHANDISE PAGE ("/merch")
// -----------------------------------------------------------------------------
// K1P sells branded streetwear. There are no individual product cut-out photos,
// only lifestyle photos of models wearing the merch — so the page has two parts:
//
//   1. THE LOOKBOOK  – a gallery of the lifestyle photos (masonry style, so the
//                      mixed-shape photos keep their natural proportions and
//                      never get awkwardly cropped).
//   2. SHOP THE RANGE – a clean price list of every product as an equal-height
//                       card, each with an "Order on WhatsApp" button. Crop tops
//                       are grouped under their own sub-heading.
//
// Ordering is by WhatsApp only — there is deliberately NO cart or checkout.
// All content comes from src/data/merchandise.js so the owner edits it there.
// Built mobile-first throughout.
// -----------------------------------------------------------------------------

import { existsSync } from 'node:fs';
import path from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';
import MerchCard from '../components/MerchCard.astro';
import { lookbook, merchandise, cropTops } from '../data/merchandise.js';
import { webpFor } from '../lib/webp.js';

// For each lookbook photo, check at BUILD time whether the file exists yet. If
// it doesn't, the tile shows a tidy labelled placeholder (naming the file to
// drop in) instead of a broken image. `hint` is the filename shown there.
const lookbookItems = lookbook.map((item) => ({
  ...item,
  hasImage: existsSync(path.join(process.cwd(), 'public', item.image)),
  hint: item.image.replace('/images/', ''),
  // A smaller WebP version of this photo, if one exists and saves bytes.
  webp: webpFor(item.image),
}));
---

<BaseLayout
  title="K1P Streetwear & Branded Clothing | Caps, Hoodies, T-Shirts | Limpopo"
  description="Shop K1P Entertainment branded streetwear in Thohoyandou, Limpopo — caps, hoodies, T-shirts, crop tops and more. Order on WhatsApp; shirts can be personalised with your name."
>
  {/* ===================================================================== */}
  {/* SECTION 1 — THE LOOKBOOK                                               */}
  {/* ===================================================================== */}
  <section class="relative overflow-hidden">
    {/* Soft red stage-glow behind the hero heading. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 h-60 w-60 -translate-x-1/2 rounded-full bg-brand-red/20 blur-3xl"
    >
    </div>

    {/* ---- HERO ---- */}
    <div class="container-page relative py-16 text-center sm:py-20">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-brand-red sm:text-sm sm:tracking-[0.3em]">
        Streetwear
      </p>
      {/* The "—" line break: stacks on phones, reads as one line on desktop. */}
      <h1 class="text-4xl sm:text-5xl md:text-6xl">K1P Merch — Rep The Brand</h1>
      <p class="mx-auto mt-5 max-w-2xl text-base text-grey sm:text-lg">
        Quality Streetwear | Limited Stock Available
      </p>

      {/* WhatsApp-ordering note. A small pill so it reads as helpful info, not an
          error. Icon is decorative (aria-hidden) — the text already explains. */}
      <p class="mx-auto mt-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-surface px-4 py-2 text-sm text-grey">
        <svg class="shrink-0 text-whatsapp" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.515 5.26l-.999 3.648 3.973-1.042z" />
        </svg>
        All orders are placed on WhatsApp
      </p>
    </div>

    {/* ---- LOOKBOOK GALLERY ----
         MASONRY via CSS columns: 1 column on phones → 2 on tablets → 3 on
         desktop. Columns let each photo keep its NATURAL height (no cropping),
         which suits lifestyle shots. `break-inside-avoid` stops a tile from
         splitting across two columns; `mb-4` spaces them vertically. */}
    <div class="container-page pb-12 sm:pb-16">
      <h2 class="sr-only">The Lookbook</h2>
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
        {
          lookbookItems.map((item) => (
            <figure class="mb-4 break-inside-avoid overflow-hidden rounded-xl border border-white/10 bg-surface">
              {/* The relative wrapper lets the caption overlay sit on the photo. */}
              <div class="relative">
                {item.hasImage ? (
                  // Real photo: natural height (h-auto) so the masonry works.
                  // <picture> serves the smaller WebP first, original as fallback.
                  <picture class="contents">
                    {item.webp && <source srcset={item.webp} type="image/webp" />}
                    <img
                      src={item.image}
                      alt={`K1P merch: ${item.caption}`}
                      loading="lazy"
                      class="w-full"
                    />
                  </picture>
                ) : (
                  // Placeholder until the photo is added — a portrait-ish tile so
                  // the gallery still looks balanced, naming the file to drop in.
                  <div class="flex aspect-[4/5] w-full flex-col items-center justify-center gap-1 bg-gradient-to-br from-surface to-black px-3 text-center">
                    <span class="text-xs uppercase tracking-widest text-grey">Photo coming soon</span>
                    <span class="text-[11px] text-grey/70">add: {item.hint}</span>
                  </div>
                )}

                {/* Caption overlay — ALWAYS visible (not hover-only, so it works
                    on phones). A dark gradient keeps the white text readable over
                    any photo. */}
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-4 pt-12">
                  <span class="text-sm font-semibold uppercase tracking-wide text-white">
                    {item.caption}
                  </span>
                </figcaption>
              </div>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===================================================================== */}
  {/* SECTION 2 — SHOP THE RANGE (price list)                               */}
  {/* ===================================================================== */}
  <section class="border-t border-white/10 bg-black/40">
    <div class="container-page py-14 sm:py-20">
      {/* Section heading. */}
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl md:text-5xl">Shop The Range</h2>
        <p class="mx-auto mt-3 max-w-xl text-grey">
          Tap any item to order it on WhatsApp. Prices in South African Rand.
        </p>
      </div>

      {/* PERSONALISATION NOTE — a clear red-tinted banner. */}
      <div class="mx-auto mt-6 flex max-w-xl items-center justify-center gap-3 rounded-lg border border-brand-red/30 bg-brand-red/10 p-4 text-center">
        <svg class="shrink-0 text-brand-red" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19 7-7 3 3-7 7-3-3z" />
          <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
          <path d="m2 2 7.586 7.586" />
          <circle cx="11" cy="11" r="2" />
        </svg>
        <p class="text-sm font-medium text-white">
          All shirts can be personalised with your name
        </p>
      </div>

      {/* MAIN RANGE GRID — 1 column on phones → 2 on tablets → 3 on desktop.
          Equal-height cards (each MerchCard uses h-full + mt-auto). */}
      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        {merchandise.map((item) => <MerchCard name={item.name} price={item.price} />)}
      </div>

      {/* CROP TOPS — grouped under their own sub-heading. */}
      <div class="mt-12">
        <h3 class="text-2xl text-white sm:text-3xl">Crop Tops</h3>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
          {cropTops.map((item) => <MerchCard name={item.name} price={item.price} />)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
