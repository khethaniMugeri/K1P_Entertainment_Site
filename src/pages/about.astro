---
// about.astro: the ABOUT PAGE ("/about")
// -----------------------------------------------------------------------------
// Two parts:
//   1. Intro heading.
//   2. Our Story + Mission (the company narrative).
// -----------------------------------------------------------------------------

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About K1P Entertainment | Music Studio & Events Company in Thohoyandou"
  description="K1P Entertainment is a music and events company in Thohoyandou, Limpopo — recording studio, sound & stage hire, record label and artist management. Read our story and mission."
>
  {/* ===================================================================== */}
  {/* 1. INTRO                                                               */}
  {/* ===================================================================== */}
  <section class="relative overflow-hidden">
    {/* Soft red stage-glow behind the heading. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 h-60 w-60 -translate-x-1/2 rounded-full bg-brand-red/20 blur-3xl"
    >
    </div>
    <div class="container-page relative py-16 text-center sm:py-20">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-brand-red sm:text-sm sm:tracking-[0.3em]">
        Who We Are
      </p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl">About K1P</h1>
      <p class="mx-auto mt-5 max-w-2xl text-base text-grey sm:text-lg">
        Music in Venda, from the studio booth to the main stage.
      </p>
    </div>
  </section>

  {/* ===================================================================== */}
  {/* 2. OUR STORY + MISSION                                                 */}
  {/* Two columns on desktop (story | mission), stacked on phones.          */}
  {/* `max-w-...` on paragraphs keeps line length comfortable to read.      */}
  {/* ===================================================================== */}
  <section class="container-page grid grid-cols-1 items-start gap-8 pb-8 lg:grid-cols-2 lg:gap-12">
    {/* ---- Story ---- */}
    <div>
      <h2 class="text-3xl text-white sm:text-4xl">Our Story</h2>
      <div class="mt-5 space-y-4 text-grey">
        <p>
          K1P Entertainment runs on one belief. Every artist deserves the chance
          to turn their musical vision into reality. We started with a love of
          sound. We grew into a full entertainment company serving Venda and
          beyond.
        </p>
        <p>
          Today we cover the full journey. We hire out professional sound, stage
          and lighting for events. We sign and develop artists through our record
          label. We manage and promote musicians. We run a recording studio for
          recording, mixing and mastering. We share fresh house and amapiano
          mixes through our Piano Valley channel.
        </p>
        <p>
          A wedding, a concert, a graduation or a new track. Our goal stays the
          same. We help you sound and look your best.
        </p>
      </div>
    </div>

    {/* ---- Mission (highlighted card so it stands out) ---- */}
    <div class="rounded-2xl border border-brand-red/30 bg-surface p-6 shadow-glow sm:p-8">
      <h2 class="text-3xl text-white sm:text-4xl">Our Mission</h2>
      <p class="mt-5 text-grey">
        We turn musical visions into reality. We give local talent the
        equipment, the platform and the support they need to grow. We give every
        event the energy of a live show.
      </p>
      {/* A short, punchy values list. SVG ticks (not emojis) stay on-brand. */}
      <ul class="mt-6 space-y-3">
        {
          [
            'Professional gear and sound for every event',
            'Real opportunities for local artists and DJs',
            'Quality recording, mixing and mastering',
            'Photography and videography',
            'Event hosting, management and promotion',
            'DJ classes',
          ].map((value) => (
            <li class="flex items-start gap-3 text-white">
              <svg
                class="mt-1 shrink-0 text-brand-red"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
