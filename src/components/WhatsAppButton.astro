---
// WhatsAppButton.astro
// -----------------------------------------------------------------------------
// ONE reusable "Book on WhatsApp" button, used all over the site (equipment
// cards, service cards, the hero, the contact page, the footer). WhatsApp is
// K1P's PRIMARY booking method, so this button is styled in WhatsApp green with
// the WhatsApp logo, making it instantly recognisable.
//
// When tapped it opens a WhatsApp chat to K1P with a message ALREADY TYPED IN
// (e.g. naming the exact equipment or service the visitor is looking at), so the
// owner immediately knows what the enquiry is about. The link is built by the
// shared `whatsappLink()` helper in src/data/site.js, so the phone number lives
// in only one place.
//
// Props:
//   message – the text pre-filled into the chat (name the equipment/service!).
//             Optional: a friendly default opener is used if you omit it.
//   label   – the button text (default "Book on WhatsApp").
//   block   – set true to make it full-width (used inside cards so it lines up).
//   class   – any extra classes to tweak size/spacing for a specific spot.
// -----------------------------------------------------------------------------

import { whatsappLink, whatsappDefaultMessage } from '../data/site.js';

const {
  message = whatsappDefaultMessage,
  label = 'Book on WhatsApp',
  block = false,
  class: extraClass = '',
} = Astro.props;

// Build the final wa.me link (with the message URL-encoded for us).
const href = whatsappLink(message);
---

{/* `target="_blank"` opens WhatsApp without navigating the visitor away from
    the site; `rel="noopener"` is a small security best-practice for new tabs.
    `inline-flex` keeps the logo and the label centred side by side. */}
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded bg-whatsapp px-6 py-4 text-center font-semibold uppercase tracking-wide text-white shadow-glow-whatsapp transition hover:bg-whatsapp-dark',
    block && 'w-full',
    extraClass,
  ]}
>
  {/* The official WhatsApp glyph (a filled icon, so `fill="currentColor"` makes
      it white to match the text). `aria-hidden` because the label already says
      what it does, so screen readers don't announce the icon twice. */}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class="shrink-0"
  >
    <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.515 5.26l-.999 3.648 3.973-1.042zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
  </svg>
  {label}
</a>
