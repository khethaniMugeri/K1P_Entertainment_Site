---
// QuoteForm.astro
// -----------------------------------------------------------------------------
// ONE reusable enquiry/quote form, designed to be dropped onto the Contact,
// Hire and Services pages (per the project brief). When someone submits it, the
// free Web3Forms service emails the message to the owner, no server needed.
//
// Fields: name, email, phone, "what are you enquiring about", and a message.
// The "enquiring about" field is PRE-FILLED automatically when the visitor
// arrives from a specific item (e.g. /contact?enquiry=Sound%20System).
//
// Built for good UX + accessibility:
//   • every field has a VISIBLE label (not just placeholder text)
//   • required fields are marked with a red * and aria-required
//   • the email/phone fields use the right input types (better mobile keyboards)
//   • on submit: button shows "Sending…", then a success or error message
//     appears in a polite live region (announced to screen readers)
//   • a hidden "honeypot" field traps spam bots
// -----------------------------------------------------------------------------

import { site } from '../data/site.js';

// `heading`/`intro` let each page give the form its own title text if it wants.
const {
  heading = 'Request a Quote',
  intro = 'Tell us what you need and we’ll get back to you with a price.',
} = Astro.props;
---

<div class="rounded-2xl border border-white/10 bg-surface p-6 sm:p-8">
  <h2 class="text-2xl text-white sm:text-3xl">{heading}</h2>
  <p class="mt-2 text-sm text-grey">{intro}</p>

  {/* `novalidate` is intentionally OFF: we let the browser do basic checks
      (required, valid email) for free. The id lets our script find the form. */}
  <form id="quote-form" class="mt-6 space-y-5">
    {/* ---- Hidden fields Web3Forms needs (not shown to the visitor) ---- */}
    {/* The public access key that routes the email to the owner. */}
    <input type="hidden" name="access_key" value={site.web3formsKey} />
    {/* The subject line of the email the owner receives. */}
    <input type="hidden" name="subject" value="New enquiry from the K1P website" />
    {/* A friendly "from" name shown in the owner's inbox. */}
    <input type="hidden" name="from_name" value="K1P Entertainment Website" />

    {/* ---- Honeypot ---- Real people never see or fill this. Bots often do;
        if it's filled, Web3Forms (and our script) treat it as spam. ---- */}
    <input
      type="checkbox"
      name="botcheck"
      tabindex="-1"
      autocomplete="off"
      class="hidden"
      aria-hidden="true"
    />

    {/* ---- Name ---- */}
    <div>
      <label for="qf-name" class="block text-sm font-medium text-white">
        Your name <span class="text-brand-red" aria-hidden="true">*</span>
      </label>
      <input
        id="qf-name"
        name="name"
        type="text"
        required
        aria-required="true"
        autocomplete="name"
        class="mt-2 w-full rounded-lg border border-white/15 bg-black/40 px-4 py-3 text-white placeholder:text-grey/60 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/40"
        placeholder="e.g. Thabo Mokoena"
      />
    </div>

    {/* ---- Email + Phone ---- side by side on bigger screens, stacked on phones. */}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="qf-email" class="block text-sm font-medium text-white">
          Email <span class="text-brand-red" aria-hidden="true">*</span>
        </label>
        <input
          id="qf-email"
          name="email"
          type="email"
          required
          aria-required="true"
          autocomplete="email"
          class="mt-2 w-full rounded-lg border border-white/15 bg-black/40 px-4 py-3 text-white placeholder:text-grey/60 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/40"
          placeholder="you@example.com"
        />
      </div>

      <div>
        <label for="qf-phone" class="block text-sm font-medium text-white">
          Phone / WhatsApp <span class="text-brand-red" aria-hidden="true">*</span>
        </label>
        <input
          id="qf-phone"
          name="phone"
          type="tel"
          required
          aria-required="true"
          autocomplete="tel"
          class="mt-2 w-full rounded-lg border border-white/15 bg-black/40 px-4 py-3 text-white placeholder:text-grey/60 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/40"
          placeholder="063 687 9489"
        />
      </div>
    </div>

    {/* ---- What are you enquiring about ---- pre-filled from ?enquiry= ---- */}
    <div>
      <label for="qf-enquiry" class="block text-sm font-medium text-white">
        What are you enquiring about?
      </label>
      <input
        id="qf-enquiry"
        name="enquiry"
        type="text"
        class="mt-2 w-full rounded-lg border border-white/15 bg-black/40 px-4 py-3 text-white placeholder:text-grey/60 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/40"
        placeholder="e.g. Sound system hire, studio booking…"
      />
    </div>

    {/* ---- Message ---- */}
    <div>
      <label for="qf-message" class="block text-sm font-medium text-white">
        Message <span class="text-brand-red" aria-hidden="true">*</span>
      </label>
      <textarea
        id="qf-message"
        name="message"
        rows="5"
        required
        aria-required="true"
        class="mt-2 w-full rounded-lg border border-white/15 bg-black/40 px-4 py-3 text-white placeholder:text-grey/60 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/40"
        placeholder="Tell us about your event: date, venue, how many people…"
      ></textarea>
    </div>

    {/* ---- Submit button ---- full width + 44px+ tall for easy tapping. ---- */}
    <button
      id="qf-submit"
      type="submit"
      class="block w-full rounded-lg bg-brand-red px-6 py-4 font-semibold uppercase tracking-wide text-white shadow-glow transition hover:bg-brand-red-dark disabled:cursor-not-allowed disabled:opacity-60"
    >
      Send Enquiry
    </button>

    {/* ---- Status message ---- empty until after submit. `aria-live="polite"`
        makes screen readers announce success/error without stealing focus. ---- */}
    <p id="qf-status" role="status" aria-live="polite" class="text-center text-sm"></p>
  </form>
</div>

<script>
  // This runs in the visitor's browser and handles the form submission.
  const form = document.getElementById('quote-form');

  if (form) {
    const submitBtn = document.getElementById('qf-submit');
    const status = document.getElementById('qf-status');
    const enquiryInput = document.getElementById('qf-enquiry');

    // 1) PRE-FILL the "enquiring about" field from the URL, e.g.
    //    /contact?enquiry=Sound%20System  ->  field shows "Sound System".
    const params = new URLSearchParams(window.location.search);
    const enquiry = params.get('enquiry');
    if (enquiry && enquiryInput) enquiryInput.value = enquiry;

    // Small helper to show a coloured status message under the button.
    const showStatus = (message, ok) => {
      status.textContent = message;
      status.className = `text-center text-sm ${ok ? 'text-green-400' : 'text-brand-red'}`;
    };

    // 2) HANDLE SUBMIT, send to Web3Forms in the background (no page reload).
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); // stop the normal full-page form submit

      // Let the browser flag empty/invalid required fields first.
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Honeypot: if the hidden checkbox got ticked, it's a bot, quietly stop.
      if (form.botcheck && form.botcheck.checked) return;

      // Gather all the field values into a plain object, then JSON.
      const data = Object.fromEntries(new FormData(form).entries());

      // Show a "sending" state and prevent double-clicks.
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      showStatus('', true);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });
        const result = await response.json();

        if (result.success) {
          // Success: thank them and clear the form for a clean slate.
          showStatus('Thanks. Your enquiry has been sent. We will reply soon.', true);
          form.reset();
        } else {
          // Web3Forms responded but rejected it (often a missing/wrong key).
          showStatus(
            'Sorry, something went wrong sending your message. Please call or WhatsApp us instead.',
            false
          );
        }
      } catch (error) {
        // Network problem (e.g. visitor is offline).
        showStatus(
          'No internet connection? Please try again, or call/WhatsApp us instead.',
          false
        );
      } finally {
        // Always restore the button so they can try again if needed.
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Enquiry';
      }
    });
  }
</script>
