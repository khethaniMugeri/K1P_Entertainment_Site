---
// AnnouncementBar.astro
// -----------------------------------------------------------------------------
// A slim strip pinned to the very top of every page that promotes the current
// headline event. The visitor can dismiss it with the × button, and we remember
// that choice in their browser (localStorage) so it stays closed on later
// visits, until the owner publishes a NEW headline event.
//
// It is DATA-DRIVEN: it reads the event marked "isHeadline" from
// src/data/events.json, so the owner changes the message by editing that file.
// -----------------------------------------------------------------------------

// The code between these "---" fences runs on the SERVER while the page is built
// (this is Astro's "frontmatter"). Nothing here ships to the browser as JS.
import eventsData from '../data/events.json';

// Find the one event flagged as the headline. `.find` returns the first match.
const headline = eventsData.events.find((event) => event.isHeadline);

// We build a unique key from the event title. If the owner later changes the
// headline event, the key changes too, so the bar reappears for everyone.
const dismissKey = headline ? `k1p-announce-dismissed:${headline.title}` : '';
---

{/* Only render the bar at all if there IS a headline event to show. */}
{
  headline && (
    <div
      id="announcement-bar"
      data-dismiss-key={dismissKey}
      class="relative bg-brand-red text-white text-sm md:text-base"
    >
      <div class="container-page flex items-center justify-center gap-3 py-2.5 pr-12 text-center">
        {/* The message links straight to the event's call-to-action page. */}
        <a
          href={headline.ctaLink}
          class="inline-flex flex-wrap items-center justify-center gap-x-2 font-medium hover:underline"
        >
          {/* A small "live" dot for a sense of urgency/energy. */}
          <span
            aria-hidden="true"
            class="inline-block h-2 w-2 shrink-0 rounded-full bg-white"
          />
          <span class="font-display tracking-wide">{headline.title}</span>
          <span class="text-white">· {headline.ctaLabel} →</span>
        </a>
      </div>

      {/* Dismiss (close) button. We keep the × icon small but make the BUTTON a
          full-height, 44px-wide tap target so it's easy to hit with a thumb. */}
      <button
        id="announcement-dismiss"
        type="button"
        aria-label="Dismiss announcement"
        class="absolute right-0 top-0 grid h-full w-11 place-items-center text-white/90 transition hover:bg-black/20 hover:text-white"
      >
        {/* SVG "×" icon (not an emoji) so it stays crisp and on-brand. */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  )
}

{/*
  This small script DOES run in the browser. It handles two things:
    1. On load: if the visitor already dismissed THIS headline, hide the bar.
    2. On clicking ×: hide the bar and remember the choice in localStorage.
  We keep it tiny and dependency-free (plain JavaScript).
*/}
<script>
  // Grab the bar and the close button from the page.
  const bar = document.getElementById('announcement-bar');
  const dismissBtn = document.getElementById('announcement-dismiss');

  if (bar && dismissBtn) {
    // The unique key we set on the element above (per headline event).
    const key = bar.dataset.dismissKey;

    // 1. Already dismissed before? Hide it immediately, no flicker.
    if (key && localStorage.getItem(key) === 'true') {
      bar.style.display = 'none';
    }

    // 2. When the visitor clicks ×, hide the bar and remember the choice.
    dismissBtn.addEventListener('click', () => {
      bar.style.display = 'none';
      if (key) localStorage.setItem(key, 'true');
    });
  }
</script>
